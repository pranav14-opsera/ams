{
  "name": "@ams/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Next.js scaffold proving the WO-007 build pipeline (Docker + strict TypeScript) works end to end. The full design system, routing, and pages are WO-050's scope.",
