{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ams.internal/schemas/rest-telemetry-event.schema.json",
  "title": "RestTelemetryEventInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "tenant_id", "event_type"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "agent_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": { "type": "string", "enum": ["heartbeat", "metric", "trace", "error"] },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "duration_ms": { "type": ["number", "null"], "minimum": 0, "description": "Convenience alias for latency_ms." },
    "error_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "token_consumption": { "type": ["number", "null"], "minimum": 0 },
    "tokens": { "type": ["number", "null"], "minimum": 0, "description": "Convenience alias for token_consumption." },
    "tool_call_success": { "type": ["boolean", "null"] },
    "tool_call_name": { "type": ["string", "null"] },
    "adapter_version": { "type": "string" },
    "raw_payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": { "type": "object" }
  }
}
